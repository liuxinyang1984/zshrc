# 公共 alias（无密钥）。mysql / 主机 ssh 放到 ~/.config/shell/local/*.alias

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -l --icons --group-directories-first --git'
  alias la='eza -la --icons --group-directories-first --git'
  alias lt='eza --tree --icons --group-directories-first -L 2'
elif command -v exa >/dev/null 2>&1; then
  alias ls='exa --icons --group-directories-first'
  alias ll='exa -l --icons --group-directories-first --git'
  alias la='exa -la --icons --group-directories-first --git'
  alias lt='exa --tree --icons --group-directories-first -L 2'
else
  alias ls='ls --color'
  alias ll='ls -lh'
  alias la='ls -alh'
fi

if command -v nvim >/dev/null 2>&1; then
  alias vi='nvim'
  alias vim='nvim'
fi
[[ -f $HOME/git/vim_server/vimrc ]] && alias vimserver='/usr/bin/vim -u $HOME/git/vim_server/vimrc'

alias proxyon="export http_proxy=http://127.0.0.1:1081 https_proxy=http://127.0.0.1:1081 ALL_PROXY=socks5h://127.0.0.1:1080 && echo '终端代理已开启'"
alias proxyoff="unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy && echo '终端代理已关闭'"
